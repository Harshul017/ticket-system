# Secret key used to sign JWTs. Set this to a long random string in any
# real deployment — never use the fallback dev value in production.
JWT_SECRET=replace-this-with-a-long-random-string

# Path to the SQLite database file. Defaults to ticket-system.db if unset.
DB_PATH=ticket-system.db

# Port the HTTP server listens on. Defaults to 8080 if unset.
PORT=8080
